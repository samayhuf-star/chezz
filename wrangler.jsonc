{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chezz",
  "main": "src/worker.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./web-dist", "binding": "ASSETS", "html_handling": "none", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }, { "name": "ROOM", "class_name": "GameRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby", "GameRoom"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "chezz", "database_id": "b6e63886-1235-48b1-bd53-23c2729f24ea" }]
}
