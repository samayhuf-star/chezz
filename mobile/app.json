{
  "expo": {
    "name": "Chesz",
    "slug": "chezz",
    "scheme": "chezz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#16181d",
    "ios": {
      "bundleIdentifier": "com.samayvashsht.chezz",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.samayvashsht.chezz",
      "adaptiveIcon": {
        "backgroundColor": "#4FD1A5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-build-properties",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16181d",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "69ad94bf-9867-4e74-9af4-2a1d760c5215"
      },
      "privacyPolicyUrl": "https://chezz.samayhuf.workers.dev/privacy.html"
    },
    "description": "Play chess against 50 bot levels with real clocks and climb the city, state, country and world leaderboards."
  }
}
